PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
# Aiven: get this from the Aiven console → your DB → Connection Info
DATABASE_URL=postgres://user:password@host:25377/defaultdb?sslmode=require

# Individual DB fields (used as fallback if DATABASE_URL is absent)
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=defaultdb
DB_USER=your-db-user
DB_PASS=your-db-password
DB_SSL=require

# SSL certificate verification for remote DB connections.
# Set to true in production (recommended). Set to false only for local dev.
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRES_IN=7d

# Cookie signing secret — generate with: openssl rand -hex 32
COOKIE_SECRET=replace_with_64_char_random_hex

# Admin seed credentials (used by seed.js only — not used at runtime)
# Password must be ≥8 chars, contain uppercase, lowercase, and a number
ADMIN_EMAIL=admin@uhshealthcare.com
ADMIN_PASSWORD=Admin123!

# Email / Nodemailer (leave blank to use console simulator in development)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_pass
EMAIL_FROM=noreply@uhshealthcare.com

# Admin notification email for payment receipts, system alerts, etc.
ADMIN_NOTIFICATION_EMAIL=admin@uhshealthcare.com

# CORS allowed origins (comma-separated)
FRONTEND_URL=http://localhost:5500

# Trust proxy: set to 1 if behind Nginx / Render / other reverse proxy
TRUST_PROXY=0

# Stripe (optional — leave blank for development mock mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
