# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this to .env and fill in real values
# ============================================

PORT=5000
NODE_ENV=production

# PostgreSQL Connection String (Aiven or other provider)
# Format: postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgres://user:password@host:25377/defaultdb?sslmode=require

# JWT (generate a 64-character random hex string)
#   Linux/macOS: openssl rand -hex 32
#   Node.js:     require('crypto').randomBytes(32).toString('hex')
JWT_SECRET=your_64_char_hex_jwt_secret_here_change_this_in_production
JWT_EXPIRES_IN=7d

# Cookie secret for signed cookies
COOKIE_SECRET=your_64_char_hex_cookie_secret_here_change_this_in_production

# Admin credentials (used only for seeding)
ADMIN_EMAIL=admin@uhshealthcare.com
ADMIN_PASSWORD=YourStrongPassword123!

# Email (production — use SendGrid, Amazon SES, or Mailgun)
# ----- SendGrid -----
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=SG.your_sendgrid_api_key
#
# ----- Amazon SES -----
# EMAIL_HOST=email.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USER=YOUR_SES_SMTP_USER
# EMAIL_PASS=YOUR_SES_SMTP_PASS
#
# ----- Mailgun -----
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_USER=postmaster@mg.yourdomain.com
# EMAIL_PASS=your_mailgun_password
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=SG.your_sendgrid_api_key_here
EMAIL_FROM=noreply@uhshealthcare.com

# Frontend URL (used for CORS and email links)
FRONTEND_URL=https://www.uhshealthcare.com

# Trust proxy (set to 1 when behind Nginx or Cloudflare)
TRUST_PROXY=1

# Stripe Payment Processing
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
