{
  "version": 2,
  "installCommand": "cd backend && npm install",
  "builds": [
    {
      "src": "backend/vercel-entry.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/vercel-entry.js" },
    { "src": "/admin(.*)", "dest": "backend/vercel-entry.js" },
    { "src": "/patient(.*)", "dest": "backend/vercel-entry.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "backend/vercel-entry.js" }
  ]
}
