{
  "name": "uhs-healthcare",
  "version": "1.0.0",
  "private": true,
  "description": "UHS Healthcare – full production deployment",
  "scripts": {
    "build:css": "cleancss -o css/styles.min.css css/reset.css css/variables.css css/layout.css css/components.css css/responsive.css",
    "build:js": "terser js/main.js js/testimonials.js js/faq.js -o js/app.min.js --compress --mangle",
    "build": "npm run build:css && npm run build:js",
    "dev": "npm run dev:backend",
    "install:backend": "cd backend && npm install",
    "start:backend": "cd backend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "seed": "cd backend && npm run seed",
    "deploy:prepare": "npm run build && npm run install:backend",
    "vercel-build": "cd backend && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.14",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "terser": "^5.31.0"
  }
}
